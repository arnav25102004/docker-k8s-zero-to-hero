#!/usr/bin/env bash
# D05 fix: the same docker run, with the correct (copy-pasted) image tag.
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=/dev/null
source "$HERE/../../_lib.sh"

IMAGE="corentinth/it-tools:2024.10.22-7ca5933"

tools_up() { [ "$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 http://localhost:8105)" = "200" ]; }

need_docker
ensure_image "$IMAGE" "about 24 MB"
say "Starting IT-Tools with the tag that really exists…"
docker rm -f d05-tools >/dev/null 2>&1
docker run -d --name d05-tools --label z2h.scenario=d05 -p 8105:80 "$IMAGE" >/dev/null \
  || die "docker run failed. Is Docker healthy?"
wait_for "IT-Tools to answer on port 8105" 60 tools_up \
  || die "IT-Tools didn't come up in time. Check: docker logs d05-tools"

show_next "✅ Fixed. Now verify it yourself:" \
  "Open http://localhost:8105 (playground: the port 8105 URL)" \
  "docker ps"
